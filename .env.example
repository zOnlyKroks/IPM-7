# Optional: Kopie dieser Datei als .env anlegen und anpassen. Ohne .env gelten dieselben Standardwerte
# (siehe docker-compose.yml). Die .env kommt nie ins Repository.

# --- Datenbank
POSTGRES_USER=argos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=argos

# --- Schluessel (fuer lokale Entwicklung reichen beliebige Zufallswerte)
INTERNAL_API_KEY=change-me-internal
JWT_SECRET=change-me-jwt
WEBHOOK_SECRET=change-me-webhook
# Achtung: n8n speichert den Schluessel beim ersten Start im Volume (Standardwert ohne .env: dev-n8n-key).
# Eine spaetere Aenderung fuehrt zu "Mismatching encryption keys", ausser man loescht vorher: docker volume rm argos_n8n_data
N8N_ENCRYPTION_KEY=dev-n8n-key

# --- Lokale KI
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=bge-m3
# Standard ist der Ollama-Container. Fuer Ollama nativ auf dem Host (z. B. AMD unter Windows):
# OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434
LT_LOAD_ONLY=en,de,fr

# --- Weboberflaeche
WEB_PORT=8080
